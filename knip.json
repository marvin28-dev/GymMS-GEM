{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "entry": ["tests/**/*.{mjs,cjs,js}", "vitest.config.mjs", "playwright.config.js"],
      "project": ["tests/**/*.{mjs,cjs,js}"]
    },
    "gem-backend": {
      "entry": ["src/index.js", "prisma/seed.js", "scripts/migrate.js", "scripts/move-logos.js"],
      "project": ["src/**/*.js", "prisma/**/*.js", "*.js"]
    },
    "gem-frontend": {
      "entry": ["src/main.jsx"],
      "project": ["src/**/*.{js,jsx}"]
    }
  }
}
