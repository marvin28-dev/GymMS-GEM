# The backend's settings. Copy this file to .env and fill it in; never commit
# .env. Values here are placeholders, not real keys.

# Required: the server will not start without these
DATABASE_URL=postgresql://user:password@localhost:5432/gem
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Where the web app lives: links in emails (resets, welcomes) point here
FRONTEND_URL=http://localhost:5173
# Other sites allowed to call the API, comma-separated. Local development
# addresses (http://localhost:<any port>) are always allowed.
ALLOWED_ORIGINS=
PORT=5000
# Behind a proxy, how many hops to trust. On Railway (RAILWAY_ENVIRONMENT set)
# it is 1 unless set here.
TRUST_PROXY=

# Email (Resend). Until a sending domain is verified, mail only reaches the
# Resend account's own inbox; set EMAIL_FROM_ADDRESS once it is.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# Where the Help & support page's reports are emailed. Empty: GEM's own
# support address (src/utils/support.js).
SUPPORT_EMAIL=

# Photos (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Text messages: "twilio", or "log" (test mode: texts are written to the
# server log and nothing is sent). Empty switches texting off.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a registered sender (a name or a number) or a messaging service
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
