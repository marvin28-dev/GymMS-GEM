# Dependencies
node_modules/
gem-frontend/node_modules/
gem-backend/node_modules/

# Environment files: never commit these, they hold passwords and keys.
# Every variant is ignored at any depth (.env.test, .env.production...),
# except the example files, which list the names with no real values.
.env
.env.*
!.env.example

# Personal notes with sign-in details
Documents/login.txt

# Build output
gem-frontend/dist/
gem-frontend/build/

# Uploaded files
gem-backend/uploads/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Prisma
gem-backend/prisma/*.db

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
