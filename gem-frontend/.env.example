# The web app's settings, read when it is built. Copy to .env and fill in;
# never commit .env.

# The backend's API address
VITE_API_URL=http://localhost:5000/api

# GEM's own support contacts, shown on the landing, sign-up and sign-in pages.
# Leave empty to show none. The WhatsApp number with its country code.
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_WHATSAPP=

# Where photos are kept (the page's content policy lets them in). Cloudinary's
# own address unless the photo store has another.
VITE_PHOTO_HOST=https://res.cloudinary.com
